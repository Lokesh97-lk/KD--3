# Application Settings
PROJECT_NAME="CodeIntellect"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
SECRET_KEY="dev-secret-key-change-in-production-replace-with-secure-random"
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Database Settings
# For PostgreSQL (Docker / Production / Local Postgres):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codeintellect"
# For Local Development fallback when PostgreSQL is not running:
DATABASE_URL="sqlite:///./data/codeintellect.db"

POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="codeintellect"

# CORS Origins (JSON list of strings)
CORS_ORIGINS='["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]'

# Code Runner Service (Isolated execution container)
CODE_RUNNER_URL="http://localhost:8001"
CODE_RUNNER_SECRET="runner-secret-key-change-in-prod"
